<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDFsharp 6.2.4 é a última versão MIT. A 6.5+ é AGPL-3.0 com chave de licença: NÃO atualizar. -->
    <!-- PdfPig (Apache-2.0): leitura do texto com posição de cada palavra (realçar/sublinhar/riscar; Etapa 5). -->
    <InternalsVisibleTo Include="PDFStudio.Tests" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Etapa 5.10: fontes "gêmeas" (Liberation, Carlito, Caladea; licença SIL OFL 1.1, textos em Fonts/OFL-*.txt). -->
    <None Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Fonts" />
  </ItemGroup>

</Project>
