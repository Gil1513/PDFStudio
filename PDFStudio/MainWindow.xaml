<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PDFStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PDFStudio"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PDF Studio"
    mc:Ignorable="d">

    <!--  KeyboardAcceleratorPlacementMode="Hidden": o atalho vale na janela toda, mas sem a dica "Ctrl+O"
          aparecendo sempre que o mouse para em qualquer lugar  -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ShellBackgroundBrush}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Invoked="OpenAccelerator_Invoked" Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="AppTitleBar"
            Title="PDF Studio"
            Background="{ThemeResource SidebarBackgroundBrush}"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Logo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Navigated="ContentFrame_Navigated" />
    </Grid>
</Window>
