<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudio.Pages.BatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PDFStudio.Pages">

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="PDFs em lote" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Escolha a ação, adicione os arquivos e clique em Iniciar. Os originais não são alterados: o resultado é salvo em arquivos novos."
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="StatusAction" Click="StatusAction_Click" Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Ações (a lista rola quando a janela é baixa)  -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Ação" />
                <ListView
                    x:Name="ActionList"
                    Grid.Row="1"
                    AutomationProperties.Name="Ação"
                    ItemsSource="{x:Bind Actions}"
                    SelectionChanged="ActionList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BatchAction">
                            <Grid
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind Title}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ComboBox
                    x:Name="CompressLevelBox"
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Stretch"
                    Header="Nível de compressão"
                    SelectedIndex="1">
                    <x:String>Leve (só limpeza)</x:String>
                    <x:String>Médio (recomendado)</x:String>
                    <x:String>Forte (arquivo bem menor)</x:String>
                </ComboBox>
            </Grid>

            <!--  Arquivos  -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right">
                    <AppBarButton
                        x:Name="AddFilesButton"
                        Click="AddFiles_Click"
                        Icon="Add"
                        Label="Adicionar PDFs" />
                    <AppBarButton
                        x:Name="AddFolderButton"
                        Click="AddFolder_Click"
                        Label="Adicionar pasta">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RemoveButton"
                        Click="Remove_Click"
                        Icon="Delete"
                        IsEnabled="False"
                        Label="Remover" />
                    <AppBarButton
                        x:Name="ClearButton"
                        Click="Clear_Click"
                        Icon="Clear"
                        IsEnabled="False"
                        Label="Limpar" />
                </CommandBar>

                <Grid
                    Grid.Row="1"
                    AllowDrop="True"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    DragOver="Files_DragOver"
                    Drop="Files_Drop">
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8B9;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Arraste PDFs ou pastas para cá, ou use os botões acima" />
                    </StackPanel>
                    <ListView
                        x:Name="FilesList"
                        AutomationProperties.Name="Arquivos do lote"
                        ItemsSource="{x:Bind Files}"
                        SelectionChanged="FilesList_SelectionChanged"
                        SelectionMode="Extended">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:BatchFileEntry">
                                <Grid
                                    Padding="0,8"
                                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="{x:Bind FileGlyph}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Details}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        MaxWidth="320"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                            Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!--  Onde salvar  -->
                <Grid
                    x:Name="SaveOptions"
                    Grid.Row="2"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="OutputFolderBox"
                        Header="Salvar em"
                        IsReadOnly="True"
                        PlaceholderText="A mesma pasta de cada arquivo" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="PickFolder_Click"
                        Content="Escolher pasta…" />
                    <TextBox
                        x:Name="SuffixBox"
                        Grid.Column="2"
                        Header="Acrescentar ao nome" />
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            x:Name="SummaryText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="Progress" Visibility="Collapsed" />
                    </StackPanel>
                    <Button
                        x:Name="StopButton"
                        Grid.Column="1"
                        Click="Stop_Click"
                        Content="Parar"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="StartButton"
                        Grid.Column="2"
                        MinWidth="120"
                        Click="Start_Click"
                        Content="Iniciar"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
