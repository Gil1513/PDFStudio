<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudio.Pages.SignPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Padding="24,8,24,24"
            HorizontalAlignment="Left"
            Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Assinar digitalmente" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Assine um PDF com um certificado digital no formato .pfx (A1). A assinatura garante a autoria e detecta qualquer alteração posterior no arquivo."
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="StatusAction" Click="StatusAction_Click" Visibility="Collapsed" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  1. Documento  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="1. Documento" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="PickPdf_Click" Content="Escolher PDF…" />
                    <TextBlock
                        x:Name="PdfText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Nenhum arquivo selecionado"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <InfoBar
                    x:Name="AlreadySignedBar"
                    Title="Este PDF já tem assinatura"
                    IsClosable="False"
                    IsOpen="False"
                    Message="Ao assinar novamente, o PDF Studio regrava o arquivo e as assinaturas existentes deixam de ser válidas."
                    Severity="Warning" />
            </StackPanel>

            <!--  2. Certificado  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="2. Certificado" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="PickPfx_Click" Content="Escolher certificado .pfx…" />
                    <TextBlock
                        x:Name="PfxText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Nenhum certificado selecionado"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox
                        x:Name="PasswordInput"
                        Header="Senha do certificado"
                        PasswordChanged="PasswordInput_PasswordChanged" />
                    <Button
                        x:Name="CheckCertButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="CheckCert_Click"
                        Content="Verificar certificado"
                        IsEnabled="False" />
                </Grid>
                <InfoBar
                    x:Name="CertBar"
                    IsClosable="False"
                    IsOpen="False" />
            </StackPanel>

            <!--  3. Tipo de assinatura  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="3. Tipo de assinatura" />
                <RadioButtons x:Name="KindRadios" SelectedIndex="0" SelectionChanged="KindRadios_SelectionChanged">
                    <x:String>Invisível (fica só nos dados do arquivo)</x:String>
                    <x:String>Visível (carimbo desenhado na página)</x:String>
                </RadioButtons>
                <StackPanel
                    x:Name="VisibleOptions"
                    Spacing="12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox
                        x:Name="PageBox"
                        MinWidth="120"
                        Header="Página"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="1" />
                    <ComboBox
                        x:Name="PositionBox"
                        MinWidth="200"
                        Header="Posição do carimbo"
                        SelectedIndex="0">
                        <x:String>Canto inferior direito</x:String>
                        <x:String>Canto inferior esquerdo</x:String>
                        <x:String>Canto superior direito</x:String>
                        <x:String>Canto superior esquerdo</x:String>
                    </ComboBox>
                </StackPanel>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Texto do carimbo" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Muda só o que aparece desenhado na página. Quem assinou de verdade sempre vem do certificado, e é isso que os leitores de PDF mostram."
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="StampTitleBox"
                    Header="Primeira linha"
                    PlaceholderText="Assinado digitalmente por:"
                    TextChanged="StampText_Changed" />
                <TextBox
                    x:Name="StampNameBox"
                    Header="Nome exibido"
                    PlaceholderText="Nome do certificado"
                    TextChanged="StampText_Changed" />
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <CheckBox x:Name="StampDateCheck" Content="Mostrar data e hora" IsChecked="True" Click="StampOption_Click" />
                    <CheckBox x:Name="StampDetailsCheck" Content="Mostrar motivo, local e contato" IsChecked="True" Click="StampOption_Click" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Prévia" />
                    <Border
                        Width="345"
                        Height="108"
                        HorizontalAlignment="Left"
                        Background="#F5F9FF"
                        BorderBrush="#005FB8"
                        BorderThickness="1.5">
                        <StackPanel Padding="12,8" Spacing="1">
                            <TextBlock x:Name="PreviewTitle" FontSize="11" Foreground="#005FB8" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewName" FontSize="13" FontWeight="Bold" Foreground="Black" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewLines" FontSize="11" Foreground="Black" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  4. Detalhes  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="4. Detalhes (opcional)" />
                <TextBox x:Name="ReasonBox" TextChanged="StampText_Changed" Header="Motivo" PlaceholderText="Ex.: Aprovação do documento" />
                <TextBox x:Name="LocationBox" TextChanged="StampText_Changed" Header="Local" PlaceholderText="Ex.: São Paulo, SP" />
                <TextBox x:Name="ContactBox" TextChanged="StampText_Changed" Header="Contato" PlaceholderText="Ex.: e-mail ou telefone (aparece só no carimbo visível)" />
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Carimbo de tempo (avançado)">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Um servidor de carimbo de tempo (RFC 3161) registra a data e a hora oficiais da assinatura. Requer conexão com a internet. Deixe em branco para não usar."
                            TextWrapping="Wrap" />
                        <TextBox x:Name="TsaBox" Header="Endereço do servidor" PlaceholderText="Ex.: http://timestamp.digicert.com" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="SignButton"
                    Click="Sign_Click"
                    Content="Assinar e salvar…"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    x:Name="SignProgress"
                    Width="20"
                    Height="20"
                    IsActive="False" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
