<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudio.Pages.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctl="using:PDFStudio.Controls"
    xmlns:pages="using:PDFStudio.Pages"
    xmlns:svc="using:PDFStudio.Services"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="O" Invoked="Accel_Open" Modifiers="Control" />
        <KeyboardAccelerator Key="D" Invoked="Accel_Properties" Modifiers="Control" />
        <KeyboardAccelerator Key="S" Invoked="Accel_SaveCopy" Modifiers="Control,Shift" />
        <KeyboardAccelerator Key="S" Invoked="Accel_Save" Modifiers="Control" />
        <KeyboardAccelerator Key="Z" Invoked="Accel_Undo" Modifiers="Control" />
        <KeyboardAccelerator Key="Y" Invoked="Accel_Redo" Modifiers="Control" />
        <KeyboardAccelerator Key="Add" Invoked="Accel_ZoomIn" Modifiers="Control" />
        <KeyboardAccelerator Key="Subtract" Invoked="Accel_ZoomOut" Modifiers="Control" />
        <KeyboardAccelerator Key="Number0" Invoked="Accel_FitWidth" Modifiers="Control" />
        <KeyboardAccelerator Key="F11" Invoked="Accel_FullScreen" />
        <KeyboardAccelerator Key="Escape" Invoked="Accel_ExitFullScreen" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!--  Botão da barra superior: ícone + nome ao lado  -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!--  Botões só com ícone (trilho direito, desfazer etc.)  -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="RailToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
            <ColumnDefinition Width="52" />
        </Grid.ColumnDefinitions>

        <!--  ================= TRILHO ESQUERDO: categorias =================  -->
        <Grid
            Margin="8,0,0,0"
            Background="{ThemeResource SidebarBackgroundBrush}"
            CornerRadius="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Menu Arquivo  -->
            <Button
                x:Name="FileMenuButton"
                Margin="6,8,6,4"
                Padding="0,8"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Arquivo"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="8"
                ToolTipService.ToolTip="Arquivo">
                <StackPanel Spacing="4">
                    <Border
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#4F8BFF" />
                                <GradientStop Offset="1" Color="#8A5CF6" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon
                            FontSize="16"
                            Foreground="White"
                            Glyph="&#xE700;" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="Arquivo" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="FileMenu" Opening="FileMenu_Opening" Placement="RightEdgeAlignedTop">
                        <MenuFlyoutItem Click="Open_Click" KeyboardAcceleratorTextOverride="Ctrl+O" Text="Abrir…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem x:Name="RecentSubMenu" Text="Arquivos recentes">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE81C;" />
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem
                            x:Name="SaveMenuItem"
                            Click="Save_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+S"
                            Text="Salvar">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveAsMenuItem" Click="SaveAs_Click" Text="Salvar como…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE792;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="SaveCopyMenuItem"
                            Click="SaveCopy_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                            Text="Salvar uma cópia…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE792;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Name="PropertiesMenuItem"
                            Click="Properties_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+D"
                            Text="Propriedades do documento">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ShowInFolderMenuItem" Click="ShowInFolder_Click" Text="Mostrar na pasta">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE838;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="GoHome_Click" Text="Tela inicial">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE80F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="MenuTool_Click" Tag="configuracoes" Text="Configurações">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="CloseFile_Click" Text="Fechar arquivo">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <ListView
                x:Name="CategoryList"
                Grid.Row="1"
                Padding="2,0"
                SelectionChanged="CategoryList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="56" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:ViewerCategory">
                        <StackPanel
                            Padding="0,6"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind Label}"
                            Spacing="4"
                            ToolTipService.ToolTip="{x:Bind Label}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="18"
                                Glyph="{x:Bind Glyph}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Text="{x:Bind Label}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                Grid.Row="2"
                Margin="6,4,6,8"
                Padding="0,8"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Mais opções"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="8"
                ToolTipService.ToolTip="Mais opções">
                <FontIcon FontSize="16" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedBottom">
                        <MenuFlyoutItem Click="ToggleFullScreen_Click" KeyboardAcceleratorTextOverride="F11" Text="Tela cheia">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE740;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="GoHome_Click" Text="Tela inicial">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE80F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="MenuTool_Click" Tag="configuracoes" Text="Configurações">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  ================= CENTRO: barra de ferramentas + documento =================  -->
        <Grid Grid.Column="1" Margin="10,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Barra de ferramentas da categoria  -->
            <Grid
                Padding="8,4"
                Background="{ThemeResource SidebarBackgroundBrush}"
                ColumnSpacing="4"
                CornerRadius="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        x:Name="UndoButton"
                        AutomationProperties.Name="Desfazer"
                        Click="Undo_Click"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Desfazer (Ctrl+Z)">
                        <FontIcon FontSize="15" Glyph="&#xE7A7;" />
                    </Button>
                    <Button
                        x:Name="RedoButton"
                        AutomationProperties.Name="Refazer"
                        Click="Redo_Click"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Refazer (Ctrl+Y)">
                        <FontIcon FontSize="15" Glyph="&#xE7A6;" />
                    </Button>
                    <Rectangle
                        Width="1"
                        Margin="6,10"
                        Fill="{ThemeResource SeparatorBrush}" />
                </StackPanel>

                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel
                        x:Name="ToolbarPanel"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2" />
                </ScrollViewer>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Rectangle
                        Width="1"
                        Margin="6,10"
                        Fill="{ThemeResource SeparatorBrush}" />
                    <Button
                        x:Name="QuickSaveButton"
                        AutomationProperties.Name="Salvar"
                        Click="Save_Click"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Salvar (Ctrl+S)">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    </Button>
                    <Button
                        x:Name="QuickSaveCopyButton"
                        AutomationProperties.Name="Salvar uma cópia"
                        Click="SaveCopy_Click"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Salvar uma cópia (Ctrl+Shift+S)">
                        <FontIcon FontSize="16" Glyph="&#xE792;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Imprimir"
                        Click="Soon_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="Imprimir"
                        ToolTipService.ToolTip="Imprimir (em breve)">
                        <FontIcon FontSize="16" Glyph="&#xE749;" Opacity="0.45" />
                    </Button>
                    <Button
                        x:Name="QuickPropertiesButton"
                        AutomationProperties.Name="Propriedades"
                        Click="Properties_Click"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Propriedades do documento (Ctrl+D)">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                    </Button>
                    <Button
                        x:Name="QuickFolderButton"
                        AutomationProperties.Name="Mostrar na pasta"
                        Click="ShowInFolder_Click"
                        IsEnabled="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Mostrar na pasta">
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <!--  Opções da ferramenta de comentário ativa (cor, espessura)  -->
                <Grid
                    x:Name="ToolOptionsBar"
                    Margin="0,8,0,0"
                    Padding="12,4"
                    Background="{ThemeResource SidebarBackgroundBrush}"
                    ColumnSpacing="12"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ToolNameText"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel
                        x:Name="ColorOption"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Cor" />
                        <DropDownButton x:Name="ColorButton" AutomationProperties.Name="Cor">
                            <Border
                                x:Name="ColorSwatch"
                                Width="18"
                                Height="18"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="9" />
                            <DropDownButton.Flyout>
                                <Flyout x:Name="ColorFlyout" Placement="Bottom">
                                    <StackPanel x:Name="ColorPalette" Orientation="Horizontal" Spacing="6" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <StackPanel
                        x:Name="WidthOption"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Espessura" />
                        <ComboBox
                            x:Name="WidthBox"
                            MinWidth="90"
                            AutomationProperties.Name="Espessura"
                            SelectionChanged="WidthBox_SelectionChanged" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ToolHintText"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="4"
                        Click="FinishTool_Click"
                        Content="Concluir (Esc)" />
                </Grid>

                <InfoBar
                    x:Name="StatusBar"
                    Margin="0,8,0,0"
                    IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="StatusAction" Click="StatusAction_Click" Visibility="Collapsed" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!--  Documento  -->
            <Grid
                x:Name="DocumentArea"
                Grid.Row="2"
                Margin="0,8,0,0"
                Background="{ThemeResource SidebarBackgroundBrush}"
                CornerRadius="10">

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="56"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xEA90;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Abra um PDF para começar" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Use o botão abaixo ou arraste um arquivo para esta janela." />
                    <Button
                        HorizontalAlignment="Center"
                        Click="Open_Click"
                        Content="Abrir PDF"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <ProgressBar
                    x:Name="LoadingBar"
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <ScrollViewer
                    x:Name="Scroller"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    MaxZoomFactor="5"
                    MinZoomFactor="0.2"
                    ViewChanged="Scroller_ViewChanged"
                    Visibility="Collapsed"
                    ZoomMode="Enabled">
                    <ItemsRepeater
                        x:Name="PagesRepeater"
                        Margin="24"
                        HorizontalAlignment="Center"
                        ElementClearing="PagesRepeater_ElementClearing"
                        ElementPrepared="PagesRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="svc:PageSlot">
                                <Border
                                    HorizontalAlignment="Center"
                                    Background="White"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <Grid>
                                        <Image
                                            Width="{x:Bind Width}"
                                            Height="{x:Bind Height}"
                                            AutomationProperties.Name="{x:Bind Label}"
                                            Source="{x:Bind Image, Mode=OneWay}"
                                            Stretch="Uniform" />
                                        <!--  Camada onde se desenham os comentários  -->
                                        <ctl:DrawingSurface
                                            Width="{x:Bind Width}"
                                            Height="{x:Bind Height}"
                                            Background="Transparent"
                                            PointerCanceled="Surface_PointerReleased"
                                            PointerCaptureLost="Surface_PointerCaptureLost"
                                            PointerEntered="Surface_PointerEntered"
                                            PointerMoved="Surface_PointerMoved"
                                            PointerPressed="Surface_PointerPressed"
                                            PointerReleased="Surface_PointerReleased" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  ================= PAINEL LATERAL (miniaturas) =================  -->
        <Grid
            Grid.Column="2"
            Margin="0,0,6,0"
            Background="{ThemeResource SidebarBackgroundBrush}"
            CornerRadius="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="16,10,8,6">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Páginas" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Fechar painel"
                    Click="ClosePanel_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Fechar painel">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
            <ListView
                x:Name="ThumbnailList"
                Grid.Row="1"
                ContainerContentChanging="ThumbnailList_ContainerContentChanging"
                IsItemClickEnabled="True"
                ItemClick="ThumbnailList_ItemClick"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:PageSlot">
                        <StackPanel
                            Padding="0,8"
                            HorizontalAlignment="Center"
                            Spacing="4">
                            <Border
                                HorizontalAlignment="Center"
                                Background="White"
                                BorderBrush="{ThemeResource ToolCardBorderBrush}"
                                BorderThickness="1">
                                <Image
                                    Width="{x:Bind ThumbWidth}"
                                    Height="{x:Bind ThumbHeight}"
                                    Source="{x:Bind Thumbnail, Mode=OneWay}"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Number}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  ================= TRILHO DIREITO: painéis, páginas e zoom =================  -->
        <Grid
            Grid.Column="3"
            Margin="0,0,8,0"
            Padding="0,6"
            Background="{ThemeResource SidebarBackgroundBrush}"
            CornerRadius="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <ToggleButton
                    x:Name="ThumbnailsToggle"
                    AutomationProperties.Name="Miniaturas"
                    Click="ThumbnailsToggle_Click"
                    Style="{StaticResource RailToggleStyle}"
                    ToolTipService.ToolTip="Miniaturas das páginas">
                    <FontIcon FontSize="16" Glyph="&#xE8A9;" />
                </ToggleButton>
                <Button
                    AutomationProperties.Name="Marcadores"
                    Click="Soon_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="Marcadores"
                    ToolTipService.ToolTip="Marcadores (em breve)">
                    <FontIcon FontSize="16" Glyph="&#xE8A4;" Opacity="0.45" />
                </Button>
                <Button
                    AutomationProperties.Name="Comentários"
                    Click="Soon_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="Lista de comentários"
                    ToolTipService.ToolTip="Comentários (em breve)">
                    <FontIcon FontSize="16" Glyph="&#xE90A;" Opacity="0.45" />
                </Button>
                <Button
                    AutomationProperties.Name="Anexos"
                    Click="Soon_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="Anexos"
                    ToolTipService.ToolTip="Anexos (em breve)">
                    <FontIcon FontSize="16" Glyph="&#xE723;" Opacity="0.45" />
                </Button>
                <Button
                    AutomationProperties.Name="Pesquisar"
                    Click="Soon_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="Pesquisar no documento"
                    ToolTipService.ToolTip="Pesquisar no documento (em breve)">
                    <FontIcon FontSize="16" Glyph="&#xE721;" Opacity="0.45" />
                </Button>
                <Button
                    x:Name="SignaturesButton"
                    AutomationProperties.Name="Assinaturas"
                    Click="Properties_Click"
                    IsEnabled="False"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Assinaturas do documento">
                    <FontIcon FontSize="16" Glyph="&#xEE56;" />
                </Button>
            </StackPanel>

            <!--  Páginas  -->
            <StackPanel
                x:Name="PageNav"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Opacity="0.5"
                IsHitTestVisible="False"
                Spacing="2">
                <NumberBox
                    x:Name="PageNumberBox"
                    Width="40"
                    MinWidth="40"
                    Padding="0"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Página atual"
                    Minimum="1"
                    SpinButtonPlacementMode="Hidden"
                    ValueChanged="PageNumberBox_ValueChanged"
                    Value="1" />
                <TextBlock
                    x:Name="PageCountText"
                    Margin="0,2,0,4"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="0" />
                <Button
                    AutomationProperties.Name="Página anterior"
                    Click="PrevPage_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Página anterior">
                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                </Button>
                <Button
                    AutomationProperties.Name="Próxima página"
                    Click="NextPage_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Próxima página">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>

                <Rectangle
                    Height="1"
                    Margin="8,6"
                    Fill="{ThemeResource SeparatorBrush}" />

                <Button
                    AutomationProperties.Name="Ajustar à largura"
                    Click="FitWidth_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Ajustar à largura (Ctrl+0)">
                    <FontIcon FontSize="15" Glyph="&#xE9A6;" />
                </Button>
                <Button
                    AutomationProperties.Name="Página inteira"
                    Click="FitPage_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Página inteira">
                    <FontIcon FontSize="15" Glyph="&#xE7F4;" />
                </Button>
                <Button
                    x:Name="ZoomMenuButton"
                    Height="30"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Nível de zoom"
                    Background="{ThemeResource ToolCardBrush}"
                    BorderThickness="0"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Escolher o zoom">
                    <TextBlock
                        x:Name="ZoomText"
                        FontSize="12"
                        Text="100%" />
                    <Button.Flyout>
                        <MenuFlyout Placement="LeftEdgeAlignedBottom">
                            <MenuFlyoutItem Click="ZoomPreset_Click" Tag="50" Text="50%" />
                            <MenuFlyoutItem Click="ZoomPreset_Click" Tag="75" Text="75%" />
                            <MenuFlyoutItem Click="ZoomPreset_Click" Tag="100" Text="100%" />
                            <MenuFlyoutItem Click="ZoomPreset_Click" Tag="125" Text="125%" />
                            <MenuFlyoutItem Click="ZoomPreset_Click" Tag="150" Text="150%" />
                            <MenuFlyoutItem Click="ZoomPreset_Click" Tag="200" Text="200%" />
                            <MenuFlyoutItem Click="ZoomPreset_Click" Tag="300" Text="300%" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="FitWidth_Click" Text="Ajustar à largura" />
                            <MenuFlyoutItem Click="FitPage_Click" Text="Página inteira" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.Name="Aumentar zoom"
                    Click="ZoomIn_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Aumentar zoom (Ctrl +)">
                    <FontIcon FontSize="15" Glyph="&#xE8A3;" />
                </Button>
                <Button
                    AutomationProperties.Name="Diminuir zoom"
                    Click="ZoomOut_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Diminuir zoom (Ctrl -)">
                    <FontIcon FontSize="15" Glyph="&#xE71F;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
