<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudio.Pages.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:PDFStudio.Services"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="Toolbar"
            Margin="8,0"
            HorizontalAlignment="Stretch"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <CommandBar.Content>
                <TextBlock
                    x:Name="FileNameText"
                    Margin="12,14,0,0"
                    MaxWidth="360"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Nenhum arquivo aberto"
                    TextTrimming="CharacterEllipsis" />
            </CommandBar.Content>

            <AppBarButton Click="Open_Click" Icon="OpenFile" Label="Abrir">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="PropertiesButton"
                Click="Properties_Click"
                IsEnabled="False"
                Label="Propriedades"
                ToolTipService.ToolTip="Propriedades do documento (Ctrl+D)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="D" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                x:Name="ZoomOutButton"
                Click="ZoomOut_Click"
                Icon="ZoomOut"
                IsEnabled="False"
                Label="Diminuir zoom" LabelPosition="Collapsed" ToolTipService.ToolTip="Diminuir zoom (Ctrl -)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Subtract" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <TextBlock
                    x:Name="ZoomText"
                    MinWidth="48"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Text="100%"
                    TextAlignment="Center" />
            </AppBarElementContainer>
            <AppBarButton
                x:Name="ZoomInButton"
                Click="ZoomIn_Click"
                Icon="ZoomIn"
                IsEnabled="False"
                Label="Aumentar zoom" LabelPosition="Collapsed" ToolTipService.ToolTip="Aumentar zoom (Ctrl +)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Add" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="FitWidthButton"
                Click="FitWidth_Click"
                IsEnabled="False"
                Label="Ajustar à largura" LabelPosition="Collapsed" ToolTipService.ToolTip="Ajustar à largura">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9A6;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarElementContainer VerticalContentAlignment="Center">
                <StackPanel
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <NumberBox
                        x:Name="PageNumberBox"
                        AutomationProperties.Name="Página atual"
                        IsEnabled="False"
                        Minimum="1"
                        SpinButtonPlacementMode="Hidden"
                        ValueChanged="PageNumberBox_ValueChanged"
                        Value="1" />
                    <TextBlock
                        x:Name="PageCountText"
                        VerticalAlignment="Center"
                        Text="de 0" />
                </StackPanel>
            </AppBarElementContainer>
        </CommandBar>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            Margin="16,0,16,8"
            IsOpen="False" />

        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="1"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <!--  Estado vazio  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="56"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xEA90;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Abra um PDF para começar" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Use o botão abaixo ou arraste um arquivo para esta janela." />
            <Button
                HorizontalAlignment="Center"
                Click="Open_Click"
                Content="Abrir PDF"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            MaxZoomFactor="5"
            MinZoomFactor="0.2"
            ViewChanged="Scroller_ViewChanged"
            Visibility="Collapsed"
            ZoomMode="Enabled">
            <ItemsRepeater
                x:Name="PagesRepeater"
                Margin="24"
                HorizontalAlignment="Center"
                ElementClearing="PagesRepeater_ElementClearing"
                ElementPrepared="PagesRepeater_ElementPrepared">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="svc:PageSlot">
                        <Border
                            HorizontalAlignment="Center"
                            Background="White"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <Image
                                Width="{x:Bind Width}"
                                Height="{x:Bind Height}"
                                AutomationProperties.Name="{x:Bind Label}"
                                Source="{x:Bind Image, Mode=OneWay}"
                                Stretch="Uniform" />
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
