<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudio.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Padding="32,16,32,32"
            HorizontalAlignment="Left"
            Spacing="24">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Configurações" />

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Aparência" />
                <RadioButtons x:Name="ThemeRadios" SelectionChanged="ThemeRadios_SelectionChanged">
                    <x:String>Escuro</x:String>
                    <x:String>Claro</x:String>
                    <x:String>Igual ao Windows</x:String>
                </RadioButtons>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Comentários" />
                <TextBox
                    x:Name="AuthorBox"
                    MaxWidth="360"
                    HorizontalAlignment="Left"
                    Header="Nome do autor dos comentários"
                    LostFocus="AuthorBox_LostFocus"
                    PlaceholderText="Seu nome" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Aparece para quem abrir o PDF em outros programas, junto com a data de cada comentário."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Arquivos recentes" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="A lista fica só neste computador. Os arquivos com estrela são mantidos quando você limpa a lista."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="ClearRecent_Click" Content="Limpar recentes" />
                    <Button Click="ClearAll_Click" Content="Limpar tudo, inclusive as estrelas" />
                </StackPanel>
                <TextBlock x:Name="ClearedText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sobre" />
                <TextBlock x:Name="VersionText" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Bibliotecas: PDFsharp 6.2.4 (licença MIT), PdfPig 0.1.16 (licença Apache 2.0), Windows App SDK e o leitor de PDF do próprio Windows."
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
