<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudio.Pages.MergeSplitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PDFStudio.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Juntar e dividir" />

        <SelectorBar x:Name="ModeSelector" Grid.Row="1" SelectionChanged="ModeSelector_SelectionChanged">
            <SelectorBarItem x:Name="MergeTab" IsSelected="True" Text="Juntar PDFs">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="SplitTab" Text="Dividir PDF">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8C6;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="StatusAction" Click="StatusAction_Click" Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  ================= JUNTAR =================  -->
        <Grid x:Name="MergePanel" Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Adicione os arquivos e arraste-os para definir a ordem. O resultado terá as páginas na sequência da lista."
                TextWrapping="Wrap" />

            <CommandBar
                Grid.Row="1"
                HorizontalAlignment="Left"
                DefaultLabelPosition="Right">
                <AppBarButton Click="AddFiles_Click" Icon="Add" Label="Adicionar PDFs" />
                <AppBarButton
                    x:Name="MoveUpButton"
                    Click="MoveUp_Click"
                    Icon="Up"
                    IsEnabled="False"
                    Label="Subir" />
                <AppBarButton
                    x:Name="MoveDownButton"
                    Click="MoveDown_Click"
                    IsEnabled="False"
                    Label="Descer">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74B;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="RemoveButton"
                    Click="Remove_Click"
                    Icon="Delete"
                    IsEnabled="False"
                    Label="Remover" />
                <AppBarButton
                    x:Name="ClearButton"
                    Click="Clear_Click"
                    Icon="Clear"
                    IsEnabled="False"
                    Label="Limpar" />
            </CommandBar>

            <Grid
                Grid.Row="2"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                DragOver="Files_DragOver"
                Drop="Files_Drop">
                <StackPanel
                    x:Name="MergeEmpty"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8E5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Arraste PDFs para cá ou clique em &quot;Adicionar PDFs&quot;" />
                </StackPanel>
                <ListView
                    x:Name="FilesList"
                    AutomationProperties.Name="Arquivos para juntar"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    ItemsSource="{x:Bind Files}"
                    SelectionChanged="FilesList_SelectionChanged"
                    SelectionMode="Extended">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PdfFileEntry">
                            <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xEA90;" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Details}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="MergeSummary"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Nenhum arquivo" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="MergeProgress" Width="20" Height="20" IsActive="False" />
                    <Button
                        x:Name="MergeButton"
                        Click="Merge_Click"
                        Content="Juntar e salvar…"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  ================= DIVIDIR =================  -->
        <ScrollViewer x:Name="SplitPanel" Grid.Row="3" Visibility="Collapsed">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="20">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Separe um PDF em vários arquivos: uma página por arquivo ou por intervalos de páginas."
                    TextWrapping="Wrap" />

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="1. Arquivo" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="PickSplitFile_Click" Content="Escolher PDF…" />
                        <TextBlock
                            x:Name="SplitFileText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nenhum arquivo selecionado"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="2. Como dividir" />
                    <RadioButtons x:Name="SplitModeRadios" SelectedIndex="0" SelectionChanged="SplitMode_SelectionChanged">
                        <x:String>Uma página por arquivo</x:String>
                        <x:String>Por intervalos de páginas</x:String>
                    </RadioButtons>
                    <TextBox
                        x:Name="RangesBox"
                        Header="Intervalos (um arquivo para cada intervalo)"
                        IsEnabled="False"
                        PlaceholderText="Ex.: 1-3, 5, 8-  (8- = da página 8 até o fim)" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="3. Pasta de destino" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SplitFolderBox"
                            AutomationProperties.Name="Pasta de destino"
                            IsReadOnly="True"
                            PlaceholderText="Escolha um arquivo primeiro" />
                        <Button Grid.Column="1" Click="PickSplitFolder_Click" Content="Alterar…" />
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="SplitButton"
                        Click="Split_Click"
                        Content="Dividir"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing x:Name="SplitProgress" Width="20" Height="20" IsActive="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
