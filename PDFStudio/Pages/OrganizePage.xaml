<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudio.Pages.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PDFStudio.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,8,24,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Organizar páginas" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Arraste as miniaturas para mudar a ordem. Selecione uma ou mais páginas para girá-las."
                TextWrapping="Wrap" />
        </StackPanel>

        <CommandBar
            Grid.Row="1"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <AppBarButton Click="Open_Click" Icon="OpenFile" Label="Abrir PDF" />
            <AppBarSeparator />
            <AppBarButton
                x:Name="RotateLeftButton"
                Click="RotateLeft_Click"
                IsEnabled="False"
                Label="Girar à esquerda"
                ToolTipService.ToolTip="Girar 90° no sentido anti-horário (Ctrl+L)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE80D;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="L" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="RotateRightButton"
                Click="RotateRight_Click"
                IsEnabled="False"
                Label="Girar à direita"
                ToolTipService.ToolTip="Girar 90° no sentido horário (Ctrl+R)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE80C;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="MoveBackButton"
                Click="MoveBack_Click"
                Icon="Back"
                IsEnabled="False"
                Label="Mover para trás" />
            <AppBarButton
                x:Name="MoveForwardButton"
                Click="MoveForward_Click"
                Icon="Forward"
                IsEnabled="False"
                Label="Mover para frente" />
            <AppBarSeparator />
            <AppBarButton
                x:Name="SelectAllButton"
                Click="SelectAll_Click"
                Icon="SelectAll"
                IsEnabled="False"
                Label="Selecionar tudo" />
            <AppBarButton
                x:Name="ResetButton"
                Click="Reset_Click"
                Icon="Undo"
                IsEnabled="False"
                Label="Desfazer alterações" />
        </CommandBar>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="StatusAction" Click="StatusAction_Click" Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xF0E2;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Abra um PDF para ver as páginas" />
                <Button
                    HorizontalAlignment="Center"
                    Click="Open_Click"
                    Content="Abrir PDF"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
            <ProgressRing
                x:Name="LoadingRing"
                Width="40"
                Height="40"
                IsActive="False" />
            <GridView
                x:Name="PagesGrid"
                Padding="12"
                AllowDrop="True"
                AutomationProperties.Name="Páginas do documento"
                CanDragItems="True"
                CanReorderItems="True"
                ItemsSource="{x:Bind Pages}"
                SelectionChanged="PagesGrid_SelectionChanged"
                SelectionMode="Extended">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:PageItem">
                        <StackPanel
                            Width="168"
                            Padding="8"
                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                            Spacing="6">
                            <Grid
                                Width="152"
                                Height="152"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="4">
                                <Image
                                    MaxWidth="140"
                                    MaxHeight="140"
                                    RenderTransformOrigin="0.5,0.5"
                                    Source="{x:Bind Thumbnail, Mode=OneWay}"
                                    Stretch="Uniform">
                                    <Image.RenderTransform>
                                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneWay}" />
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind PositionText, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DetailText, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="SummaryText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Nenhum arquivo aberto"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="SaveProgress" Width="20" Height="20" IsActive="False" />
                <Button
                    x:Name="SaveAsButton"
                    Click="SaveAs_Click"
                    Content="Salvar como…"
                    IsEnabled="False" />
                <Button
                    x:Name="SaveButton"
                    Click="Save_Click"
                    Content="Salvar"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
