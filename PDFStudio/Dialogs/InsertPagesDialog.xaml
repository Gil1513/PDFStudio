<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.InsertPagesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Inserir páginas"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Inserir"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer Width="460" Padding="0,0,12,0">
        <StackPanel Spacing="16">
            <InfoBar
                x:Name="SignedWarning"
                Title="Este PDF tem assinatura digital"
                IsClosable="False"
                Message="Inserir páginas invalida as assinaturas existentes."
                Severity="Warning" />

            <RadioButtons
                x:Name="SourceChoice"
                Header="O que inserir"
                SelectedIndex="0"
                SelectionChanged="SourceChoice_SelectionChanged">
                <x:String>Páginas em branco</x:String>
                <x:String>Páginas de outro PDF</x:String>
            </RadioButtons>

            <!--  Páginas em branco  -->
            <StackPanel x:Name="BlankPanel" Spacing="12">
                <NumberBox
                    x:Name="CountBox"
                    Width="160"
                    HorizontalAlignment="Left"
                    Header="Quantidade"
                    Maximum="1000"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    Value="1" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox
                        x:Name="SizeBox"
                        MinWidth="240"
                        Header="Tamanho"
                        SelectionChanged="SizeBox_SelectionChanged" />
                    <ComboBox
                        x:Name="OrientationBox"
                        MinWidth="140"
                        Header="Orientação"
                        IsEnabled="False"
                        SelectedIndex="0">
                        <x:String>Retrato</x:String>
                        <x:String>Paisagem</x:String>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!--  Páginas de outro PDF  -->
            <StackPanel x:Name="PdfPanel" Spacing="12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="PickPdf_Click" Content="Escolher PDF…" />
                    <TextBlock
                        x:Name="OtherFileText"
                        MaxWidth="300"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Nenhum arquivo escolhido"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBox
                    x:Name="OtherRangesBox"
                    Header="Páginas desse PDF (em branco = todas)"
                    PlaceholderText="Ex.: 1-3, 8" />
            </StackPanel>

            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox
                        x:Name="WhereBox"
                        MinWidth="160"
                        Header="Onde"
                        SelectedIndex="1">
                        <x:String>Antes da página</x:String>
                        <x:String>Depois da página</x:String>
                    </ComboBox>
                    <NumberBox
                        x:Name="PageBox"
                        Width="140"
                        VerticalAlignment="Bottom"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline" />
                </StackPanel>
                <TextBlock
                    x:Name="PageHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <RadioButtons x:Name="TargetChoice" Header="Onde salvar" SelectedIndex="0">
                <x:String>Criar um novo arquivo (o original fica intacto)</x:String>
                <x:String>Substituir o arquivo aberto</x:String>
            </RadioButtons>

            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
