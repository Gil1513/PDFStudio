<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.DocumentPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Propriedades do documento"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click"
    PrimaryButtonText="OK"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer Width="560" Padding="0,0,16,0">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource LabelStyle}" Text="Nome do arquivo:" />
                <TextBlock
                    x:Name="FileNameText"
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Style="{StaticResource LabelStyle}" Text="Número de páginas:" />
                <TextBlock x:Name="PageCountText" Grid.Row="1" Grid.Column="1" />

                <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}" Text="Tamanho da página:" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="PageSizeText" VerticalAlignment="Center" />
                    <ComboBox x:Name="UnitBox" MinWidth="90" SelectedIndex="0" SelectionChanged="UnitBox_SelectionChanged">
                        <x:String>cm</x:String>
                        <x:String>mm</x:String>
                        <x:String>pol</x:String>
                        <x:String>pt</x:String>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="3" Style="{StaticResource LabelStyle}" Text="Título:" />
                <TextBox x:Name="TitleBox" Grid.Row="3" Grid.Column="1" />

                <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}" Text="Autor:" />
                <TextBox x:Name="AuthorBox" Grid.Row="4" Grid.Column="1" />

                <TextBlock Grid.Row="5" Style="{StaticResource LabelStyle}" Text="Assunto:" />
                <TextBox x:Name="SubjectBox" Grid.Row="5" Grid.Column="1" />

                <TextBlock
                    Grid.Row="6"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Palavras-chave:" />
                <TextBox
                    x:Name="KeywordsBox"
                    Grid.Row="6"
                    Grid.Column="1"
                    Height="72"
                    AcceptsReturn="False"
                    PlaceholderText="Separe por vírgulas"
                    TextWrapping="Wrap" />

                <TextBlock Grid.Row="7" Style="{StaticResource LabelStyle}" Text="Criador:" />
                <TextBlock
                    x:Name="CreatorText"
                    Grid.Row="7"
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />

                <TextBlock Grid.Row="8" Style="{StaticResource LabelStyle}" Text="Produtor:" />
                <TextBlock
                    x:Name="ProducerText"
                    Grid.Row="8"
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </Grid>

            <InfoBar
                x:Name="SignedWarning"
                Title="Este PDF tem assinatura digital"
                IsClosable="False"
                IsOpen="False"
                Message="Alterar as propriedades regrava o arquivo, e as assinaturas deixam de ser válidas. Por isso os campos estão bloqueados."
                Severity="Warning">
                <InfoBar.Content>
                    <CheckBox
                        x:Name="UnlockCheck"
                        Margin="0,0,0,12"
                        Click="UnlockCheck_Click"
                        Content="Quero editar mesmo assim" />
                </InfoBar.Content>
            </InfoBar>

            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" />

            <!--  Informações do arquivo  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Informações do arquivo" />
                    <TextBlock x:Name="VersionText" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Localização:" />
                        <HyperlinkButton
                            x:Name="LocationLink"
                            Padding="0"
                            Click="LocationLink_Click"
                            ToolTipService.ToolTip="Mostrar na pasta">
                            <TextBlock x:Name="LocationText" TextWrapping="Wrap" />
                        </HyperlinkButton>
                    </StackPanel>
                    <TextBlock x:Name="FileSizeText" />
                    <TextBlock x:Name="CreatedText" />
                    <TextBlock x:Name="ModifiedText" />
                    <TextBlock x:Name="EncryptedText" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!--  Assinaturas existentes  -->
            <StackPanel x:Name="SignaturesSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Assinaturas digitais" />
                <StackPanel x:Name="SignaturesList" Spacing="8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
