<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.WatermarkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Marca d'água"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Aplicar"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer>
        <Grid Width="680" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="14">
                <RadioButtons
                    x:Name="ModeChoice"
                    Header="O que fazer"
                    SelectedIndex="0"
                    SelectionChanged="ModeChoice_SelectionChanged">
                    <x:String>Colocar marca d'água</x:String>
                    <x:String>Remover marcas d'água</x:String>
                </RadioButtons>

                <StackPanel x:Name="OptionsPanel" Spacing="12">
                    <TextBox
                        x:Name="TextInput"
                        Header="Texto"
                        MaxLength="120"
                        PlaceholderText="Ex.: CONFIDENCIAL"
                        Text="CONFIDENCIAL"
                        TextChanged="Option_Changed" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="FontBox"
                            HorizontalAlignment="Stretch"
                            Header="Fonte"
                            SelectionChanged="Option_Changed" />
                        <ToggleButton
                            x:Name="BoldToggle"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Negrito"
                            Checked="Option_Changed"
                            IsChecked="True"
                            ToolTipService.ToolTip="Negrito"
                            Unchecked="Option_Changed">
                            <FontIcon FontSize="14" Glyph="&#xE8DD;" />
                        </ToggleButton>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ColorBox"
                            HorizontalAlignment="Stretch"
                            Header="Cor"
                            SelectedIndex="0"
                            SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="Cinza" Tag="#808080" />
                            <ComboBoxItem Content="Vermelho" Tag="#D32F2F" />
                            <ComboBoxItem Content="Azul" Tag="#1565C0" />
                            <ComboBoxItem Content="Verde" Tag="#2E7D32" />
                            <ComboBoxItem Content="Preto" Tag="#000000" />
                        </ComboBox>
                        <NumberBox
                            x:Name="SizeBox"
                            Grid.Column="1"
                            Header="Tamanho (vazio = automático)"
                            Maximum="500"
                            Minimum="6"
                            PlaceholderText="Automático"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="Size_ValueChanged" />
                    </Grid>

                    <Slider
                        x:Name="OpacitySlider"
                        Header="Transparência"
                        Maximum="90"
                        Minimum="0"
                        StepFrequency="5"
                        ValueChanged="Opacity_ValueChanged"
                        Value="70" />

                    <RadioButtons
                        x:Name="AngleChoice"
                        Header="Direção"
                        MaxColumns="2"
                        SelectedIndex="0"
                        SelectionChanged="Option_Changed">
                        <x:String>Diagonal</x:String>
                        <x:String>Horizontal</x:String>
                    </RadioButtons>

                    <RadioButtons
                        x:Name="LayerChoice"
                        Header="Posição"
                        SelectedIndex="0">
                        <x:String>Na frente do conteúdo</x:String>
                        <x:String>Atrás do conteúdo (não cobre o texto)</x:String>
                    </RadioButtons>
                </StackPanel>

                <RadioButtons
                    x:Name="PagesChoice"
                    Header="Em quais páginas"
                    SelectedIndex="0"
                    SelectionChanged="PagesChoice_SelectionChanged">
                    <x:String>Todas</x:String>
                    <x:String>Só estas:</x:String>
                </RadioButtons>
                <TextBox
                    x:Name="RangesBox"
                    Margin="0,-8,0,0"
                    AutomationProperties.Name="Páginas"
                    IsEnabled="False"
                    PlaceholderText="Ex.: 1-3, 8" />

                <TextBlock
                    x:Name="RemoveNote"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Prévia da página atual com a marca d'água por cima  -->
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="PreviewTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid
                    x:Name="PreviewHost"
                    BorderBrush="{ThemeResource SeparatorBrush}"
                    BorderThickness="1"
                    CornerRadius="0">
                    <Rectangle Fill="White" />
                    <Image x:Name="PreviewImage" Stretch="Fill" />
                    <Canvas x:Name="PreviewOverlay">
                        <TextBlock x:Name="PreviewText" TextAlignment="Center" />
                    </Canvas>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
