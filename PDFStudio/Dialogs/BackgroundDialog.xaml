<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.BackgroundDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fundo da página"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Aplicar"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer>
        <Grid Width="680" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="14">
                <RadioButtons
                    x:Name="ModeChoice"
                    Header="O que fazer"
                    MaxColumns="2"
                    SelectedIndex="0"
                    SelectionChanged="ModeChoice_SelectionChanged">
                    <x:String>Colocar fundo</x:String>
                    <x:String>Remover fundo</x:String>
                </RadioButtons>

                <StackPanel x:Name="OptionsPanel" Spacing="12">
                    <RadioButtons
                        x:Name="KindChoice"
                        Header="Tipo"
                        MaxColumns="2"
                        SelectedIndex="0"
                        SelectionChanged="KindChoice_SelectionChanged">
                        <x:String>Cor</x:String>
                        <x:String>Imagem</x:String>
                    </RadioButtons>

                    <ComboBox
                        x:Name="ColorBox"
                        MinWidth="220"
                        Header="Cor"
                        SelectedIndex="0"
                        SelectionChanged="Option_Changed">
                        <ComboBoxItem Content="Creme" Tag="#FFF6D5" />
                        <ComboBoxItem Content="Azul-claro" Tag="#DCEBFA" />
                        <ComboBoxItem Content="Verde-claro" Tag="#DFF2E1" />
                        <ComboBoxItem Content="Rosa-claro" Tag="#FBE3EC" />
                        <ComboBoxItem Content="Cinza-claro" Tag="#ECECEC" />
                        <ComboBoxItem Content="Amarelo" Tag="#FFE66D" />
                    </ComboBox>

                    <StackPanel x:Name="ImagePanel" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ChooseImageButton" Click="ChooseImage_Click" Content="Escolher imagem…" />
                            <TextBlock
                                x:Name="ImageNameText"
                                MaxWidth="260"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Nenhuma imagem escolhida"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <RadioButtons
                            x:Name="FitChoice"
                            Header="Como ocupar a página"
                            SelectedIndex="0"
                            SelectionChanged="Option_Changed">
                            <x:String>Cobrir a página (pode cortar as bordas)</x:String>
                            <x:String>Caber inteira (pode sobrar espaço)</x:String>
                            <x:String>Esticar (pode deformar)</x:String>
                        </RadioButtons>
                    </StackPanel>

                    <Slider
                        x:Name="IntensitySlider"
                        Header="Intensidade"
                        Maximum="100"
                        Minimum="5"
                        StepFrequency="5"
                        ValueChanged="Intensity_ValueChanged"
                        Value="100" />
                </StackPanel>

                <RadioButtons
                    x:Name="PagesChoice"
                    Header="Em quais páginas"
                    SelectedIndex="0"
                    SelectionChanged="PagesChoice_SelectionChanged">
                    <x:String>Todas</x:String>
                    <x:String>Só estas:</x:String>
                </RadioButtons>
                <TextBox
                    x:Name="RangesBox"
                    Margin="0,-8,0,0"
                    AutomationProperties.Name="Páginas"
                    IsEnabled="False"
                    PlaceholderText="Ex.: 1-3, 8" />

                <TextBlock
                    x:Name="NoteText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Prévia: papel branco, o fundo e, por cima, a página desenhada sem papel  -->
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="PreviewTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid x:Name="PreviewHost" BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="1">
                    <Rectangle Fill="White" />
                    <Rectangle x:Name="PreviewColor" />
                    <Canvas x:Name="PreviewImageLayer">
                        <Image x:Name="PreviewBackgroundImage" Stretch="Fill" />
                        <Rectangle x:Name="PreviewVeil" Fill="White" />
                    </Canvas>
                    <Image x:Name="PreviewImage" Stretch="Fill" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
