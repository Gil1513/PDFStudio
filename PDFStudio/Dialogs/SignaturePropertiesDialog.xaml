<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.SignaturePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Propriedades da assinatura"
    CloseButtonText="Fechar"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="620" Padding="0,0,12,0">
        <StackPanel Width="640" Spacing="16">
            <ComboBox
                x:Name="SignatureBox"
                HorizontalAlignment="Stretch"
                Header="Assinatura"
                SelectionChanged="SignatureBox_SelectionChanged"
                Visibility="Collapsed" />

            <!--  Situação  -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="StatusBadge"
                    Width="52"
                    Height="52"
                    VerticalAlignment="Top"
                    CornerRadius="26">
                    <FontIcon
                        x:Name="StatusIcon"
                        FontSize="24"
                        Foreground="White" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="HeadlineText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="FieldText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!--  Dados  -->
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="Assinado por:" />
                <TextBlock
                    x:Name="SignerText"
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Style="{StaticResource ValueStyle}" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource LabelStyle}"
                    Text="Motivo:" />
                <TextBlock
                    x:Name="ReasonText"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource ValueStyle}" />
                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource LabelStyle}"
                    Text="Data:" />
                <TextBlock
                    x:Name="DateText"
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource ValueStyle}" />
                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource LabelStyle}"
                    Text="Local:" />
                <TextBlock
                    x:Name="LocationText"
                    Grid.Row="3"
                    Grid.Column="1"
                    Style="{StaticResource ValueStyle}" />
                <TextBlock
                    Grid.Row="4"
                    Style="{StaticResource LabelStyle}"
                    Text="Contato:" />
                <TextBlock
                    x:Name="ContactText"
                    Grid.Row="4"
                    Grid.Column="1"
                    Style="{StaticResource ValueStyle}" />
                <StackPanel
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ToggleButton
                        x:Name="ShowCertButton"
                        Checked="ShowCert_Changed"
                        Content="Mostrar certificado"
                        Unchecked="ShowCert_Changed" />
                    <Button
                        x:Name="TrustButton"
                        Click="Trust_Click" />
                </StackPanel>
            </Grid>

            <!--  Certificado (aparece com "Mostrar certificado")  -->
            <Border
                x:Name="CertPanel"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <Grid
                    x:Name="CertGrid"
                    ColumnSpacing="16"
                    RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>

            <TextBlock
                x:Name="TrustNote"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="“Confiar neste certificado” vale só para o PDF Studio neste computador. Outros programas e outras pessoas precisam confiar nele por conta própria."
                TextWrapping="Wrap" />

            <MenuFlyoutSeparator />

            <!--  Resumo  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Resumo da validade" />
                <StackPanel x:Name="SummaryPanel" Spacing="8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
