<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.CopyPagesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Copiar páginas"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Copiar"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer Width="460" Padding="0,0,12,0">
        <StackPanel Spacing="16">
            <InfoBar
                x:Name="SignedWarning"
                Title="Este PDF tem assinatura digital"
                IsClosable="False"
                Message="Copiar páginas invalida as assinaturas existentes."
                Severity="Warning" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="A cópia fica idêntica: textos, fontes, imagens, comentários, links e campos. Campos copiados ganham um nome próprio, e assinaturas não são copiadas (fica o campo para assinar)."
                TextWrapping="Wrap" />

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="RangesBox"
                    Header="Páginas a copiar"
                    PlaceholderText="Ex.: 2 ou 1-3, 8" />
                <TextBlock
                    x:Name="RangesHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <NumberBox
                x:Name="CopiesBox"
                Width="160"
                HorizontalAlignment="Left"
                Header="Quantas cópias"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="1" />

            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox
                        x:Name="WhereBox"
                        MinWidth="180"
                        Header="Onde colocar as cópias"
                        SelectedIndex="1">
                        <x:String>Antes da página</x:String>
                        <x:String>Depois da página</x:String>
                    </ComboBox>
                    <NumberBox
                        x:Name="PageBox"
                        Width="140"
                        VerticalAlignment="Bottom"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline" />
                </StackPanel>
                <TextBlock
                    x:Name="PageHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <RadioButtons x:Name="TargetChoice" Header="Onde salvar" SelectedIndex="0">
                <x:String>Alterar este documento (dá para desfazer; o arquivo só muda ao salvar)</x:String>
                <x:String>Criar um novo arquivo (o original fica intacto)</x:String>
            </RadioButtons>

            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
