<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.HeaderFooterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cabeçalho e rodapé"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Aplicar"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">860</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer>
        <Grid Width="740" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="14">
                <RadioButtons
                    x:Name="ModeChoice"
                    Header="O que fazer"
                    MaxColumns="2"
                    SelectedIndex="0"
                    SelectionChanged="ModeChoice_SelectionChanged">
                    <x:String>Colocar</x:String>
                    <x:String>Remover</x:String>
                </RadioButtons>

                <StackPanel x:Name="OptionsPanel" Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Cabeçalho (em cima)" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HeaderLeftBox" AutomationProperties.Name="Cabeçalho à esquerda" PlaceholderText="Esquerda" TextChanged="Option_Changed" />
                        <TextBox x:Name="HeaderCenterBox" Grid.Column="1" AutomationProperties.Name="Cabeçalho no centro" PlaceholderText="Centro" TextChanged="Option_Changed" />
                        <TextBox x:Name="HeaderRightBox" Grid.Column="2" AutomationProperties.Name="Cabeçalho à direita" PlaceholderText="Direita" TextChanged="Option_Changed" />
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Rodapé (embaixo)" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FooterLeftBox" AutomationProperties.Name="Rodapé à esquerda" PlaceholderText="Esquerda" TextChanged="Option_Changed" />
                        <TextBox x:Name="FooterCenterBox" Grid.Column="1" AutomationProperties.Name="Rodapé no centro" PlaceholderText="Centro" TextChanged="Option_Changed" />
                        <TextBox x:Name="FooterRightBox" Grid.Column="2" AutomationProperties.Name="Rodapé à direita" PlaceholderText="Direita" TextChanged="Option_Changed" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inserir:" />
                        <Button Click="Insert_Click" Content="Nº da página" Tag="{}{n}" ToolTipService.ToolTip="{}{n}" />
                        <Button Click="Insert_Click" Content="Total de páginas" Tag="{}{total}" ToolTipService.ToolTip="{}{total}" />
                        <Button Click="Insert_Click" Content="Data" Tag="{}{data}" ToolTipService.ToolTip="{}{data}" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="FontBox" HorizontalAlignment="Stretch" Header="Fonte" SelectionChanged="Option_Changed" />
                        <NumberBox
                            x:Name="SizeBox"
                            Grid.Column="1"
                            Header="Tamanho"
                            Maximum="72"
                            Minimum="5"
                            SpinButtonPlacementMode="Compact"
                            Value="10"
                            ValueChanged="Number_ValueChanged" />
                        <ComboBox
                            x:Name="ColorBox"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Header="Cor"
                            SelectedIndex="0"
                            SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="Preto" Tag="#000000" />
                            <ComboBoxItem Content="Cinza" Tag="#666666" />
                            <ComboBoxItem Content="Azul" Tag="#1565C0" />
                            <ComboBoxItem Content="Vermelho" Tag="#D32F2F" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="MarginBox"
                            Header="Distância da borda (cm)"
                            LargeChange="0.5"
                            Maximum="5"
                            Minimum="0"
                            SmallChange="0.1"
                            SpinButtonPlacementMode="Compact"
                            Value="1"
                            ValueChanged="Number_ValueChanged" />
                        <NumberBox
                            x:Name="StartBox"
                            Grid.Column="1"
                            Header="Começar a numeração em"
                            Maximum="99999"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="1"
                            ValueChanged="Number_ValueChanged" />
                    </Grid>
                </StackPanel>

                <RadioButtons
                    x:Name="PagesChoice"
                    Header="Em quais páginas"
                    SelectedIndex="0"
                    SelectionChanged="PagesChoice_SelectionChanged">
                    <x:String>Todas</x:String>
                    <x:String>Só estas:</x:String>
                </RadioButtons>
                <TextBox
                    x:Name="RangesBox"
                    Margin="0,-8,0,0"
                    AutomationProperties.Name="Páginas"
                    IsEnabled="False"
                    PlaceholderText="Ex.: 2-10" />

                <TextBlock
                    x:Name="NoteText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Prévia da página atual  -->
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="PreviewTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid x:Name="PreviewHost" BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="1">
                    <Rectangle Fill="White" />
                    <Image x:Name="PreviewImage" Stretch="Fill" />
                    <Canvas x:Name="PreviewOverlay">
                        <TextBlock x:Name="PreviewHL" />
                        <TextBlock x:Name="PreviewHC" />
                        <TextBlock x:Name="PreviewHR" />
                        <TextBlock x:Name="PreviewFL" />
                        <TextBlock x:Name="PreviewFC" />
                        <TextBlock x:Name="PreviewFR" />
                    </Canvas>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
