<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.CropPagesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recortar páginas"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Recortar"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Style x:Key="MarginBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="140" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer>
        <Grid Width="640" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="16">
                <InfoBar
                    x:Name="SignedWarning"
                    Title="Este PDF tem assinatura digital"
                    IsClosable="False"
                    Message="Recortar invalida as assinaturas existentes."
                    Severity="Warning" />

                <RadioButtons
                    x:Name="ModeChoice"
                    Header="O que fazer"
                    SelectedIndex="0"
                    SelectionChanged="ModeChoice_SelectionChanged">
                    <x:String>Recortar as margens</x:String>
                    <x:String>Desfazer recortes (mostrar a página inteira)</x:String>
                </RadioButtons>

                <StackPanel x:Name="MarginsPanel" Spacing="8">
                    <TextBlock Text="Quanto cortar de cada lado (cm)" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox x:Name="TopBox" Header="Em cima" Style="{StaticResource MarginBoxStyle}" ValueChanged="Margin_ValueChanged" />
                        <NumberBox x:Name="BottomBox" Grid.Column="1" Header="Embaixo" Style="{StaticResource MarginBoxStyle}" ValueChanged="Margin_ValueChanged" />
                        <NumberBox x:Name="LeftBox" Grid.Row="1" Header="Esquerda" Style="{StaticResource MarginBoxStyle}" ValueChanged="Margin_ValueChanged" />
                        <NumberBox x:Name="RightBox" Grid.Row="1" Grid.Column="1" Header="Direita" Style="{StaticResource MarginBoxStyle}" ValueChanged="Margin_ValueChanged" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="O que fica fora do recorte é escondido, não apagado: dá para desfazer depois."
                        TextWrapping="Wrap" />
                </StackPanel>

                <RadioButtons
                    x:Name="PagesChoice"
                    Header="Em quais páginas"
                    SelectedIndex="0"
                    SelectionChanged="PagesChoice_SelectionChanged">
                    <x:String>Todas</x:String>
                    <x:String>Só estas:</x:String>
                </RadioButtons>
                <TextBox
                    x:Name="RangesBox"
                    Margin="0,-8,0,0"
                    IsEnabled="False"
                    PlaceholderText="Ex.: 1-3, 8" />

                <RadioButtons x:Name="TargetChoice" Header="Onde salvar" SelectedIndex="0">
                    <x:String>Criar um novo arquivo (o original fica intacto)</x:String>
                    <x:String>Substituir o arquivo aberto</x:String>
                </RadioButtons>

                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Prévia da página atual: as faixas escuras são o que será cortado  -->
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="PreviewTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid x:Name="PreviewHost" BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="1">
                    <Rectangle Fill="White" />
                    <Image x:Name="PreviewImage" Stretch="Fill" />
                    <Canvas x:Name="PreviewOverlay">
                        <Rectangle x:Name="CutTop" Fill="#99000000" />
                        <Rectangle x:Name="CutBottom" Fill="#99000000" />
                        <Rectangle x:Name="CutLeft" Fill="#99000000" />
                        <Rectangle x:Name="CutRight" Fill="#99000000" />
                        <Rectangle x:Name="KeptArea" Stroke="#FF4F8BFF" StrokeThickness="2" />
                    </Canvas>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
