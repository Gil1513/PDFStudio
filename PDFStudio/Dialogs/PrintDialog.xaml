<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PDFStudio.Dialogs.PrintDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Imprimir"
    CloseButtonText="Cancelar"
    Closing="Dialog_Closing"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Imprimir"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <Grid Width="780" ColumnSpacing="28" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Opções  -->
        <ScrollViewer
            x:Name="OptionsScroll"
            MaxHeight="560"
            Padding="0,0,12,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OptionsPanel" Spacing="14">
                <StackPanel Spacing="4">
                    <ComboBox
                        x:Name="PrinterBox"
                        HorizontalAlignment="Stretch"
                        Header="Impressora"
                        SelectionChanged="PrinterBox_SelectionChanged" />
                    <Grid>
                        <TextBlock
                            x:Name="PrinterNote"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                        <HyperlinkButton
                            x:Name="PreferencesButton"
                            Padding="4,2"
                            HorizontalAlignment="Right"
                            Click="Preferences_Click"
                            Content="Preferências da impressora…"
                            FontSize="12" />
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <NumberBox
                        x:Name="CopiesBox"
                        Width="130"
                        Header="Cópias"
                        LargeChange="10"
                        Maximum="999"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="1"
                        ValueChanged="Option_NumberChanged" />
                    <CheckBox
                        x:Name="CollateBox"
                        Margin="0,26,0,0"
                        VerticalAlignment="Top"
                        Click="Option_Click"
                        Content="Agrupar (1, 2, 3 · 1, 2, 3)"
                        IsChecked="True" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <RadioButtons
                        x:Name="PagesChoice"
                        Header="Páginas"
                        SelectedIndex="0"
                        SelectionChanged="PagesChoice_SelectionChanged">
                        <x:String>Todas</x:String>
                        <x:String>Página atual</x:String>
                        <x:String>Escolher:</x:String>
                    </RadioButtons>
                    <TextBox
                        x:Name="RangesBox"
                        Margin="28,0,0,0"
                        IsEnabled="False"
                        PlaceholderText="ex.: 1-3, 5, 8-"
                        TextChanged="RangesBox_TextChanged" />
                    <ComboBox
                        x:Name="ParityBox"
                        Margin="28,0,0,0"
                        SelectedIndex="0"
                        SelectionChanged="Option_SelectionChanged">
                        <x:String>Todas do intervalo</x:String>
                        <x:String>Só as ímpares (1, 3, 5…)</x:String>
                        <x:String>Só as pares (2, 4, 6…)</x:String>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnSpacing="12" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox
                        x:Name="PaperBox"
                        HorizontalAlignment="Stretch"
                        Header="Papel"
                        SelectionChanged="PaperBox_SelectionChanged" />
                    <ComboBox
                        x:Name="SizeBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="Tamanho"
                        SelectedIndex="0"
                        SelectionChanged="Option_SelectionChanged">
                        <x:String>Ajustar à folha</x:String>
                        <x:String>Tamanho real</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="DuplexBox"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Header="Frente e verso"
                        SelectedIndex="0"
                        SelectionChanged="DuplexBox_SelectionChanged">
                        <x:String>Só a frente</x:String>
                        <x:String>Frente e verso (borda longa)</x:String>
                        <x:String>Frente e verso (borda curta)</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="ColorBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="Cor"
                        SelectedIndex="0"
                        SelectionChanged="Option_SelectionChanged">
                        <x:String>Colorido</x:String>
                        <x:String>Preto e branco</x:String>
                    </ComboBox>
                </Grid>

                <CheckBox
                    x:Name="CommentsBox"
                    Click="Option_Click"
                    Content="Imprimir os comentários"
                    IsChecked="True" />

                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="True"
                    Severity="Error" />
            </StackPanel>
        </ScrollViewer>

        <!--  Prévia  -->
        <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Prévia" />
            <Grid
                x:Name="PreviewArea"
                Width="300"
                Height="400"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6">
                <Border
                    x:Name="PaperSheet"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Canvas x:Name="PaperCanvas">
                        <Rectangle
                            x:Name="PrintableFrame"
                            Stroke="#5A8AC6"
                            StrokeDashArray="3,3"
                            StrokeThickness="0.75" />
                        <Image x:Name="PreviewImage" Stretch="Fill" />
                    </Canvas>
                </Border>
                <ProgressRing
                    x:Name="PreviewRing"
                    Width="28"
                    Height="28"
                    IsActive="False" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PrevButton"
                    Click="Prev_Click"
                    ToolTipService.ToolTip="Página anterior">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>
                <TextBlock
                    x:Name="PreviewPageText"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="NextButton"
                    Grid.Column="2"
                    Click="Next_Click"
                    ToolTipService.ToolTip="Próxima página">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
            </Grid>
            <TextBlock
                x:Name="SummaryText"
                HorizontalAlignment="Center"
                FontSize="12"
                Opacity="0.75"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Andamento  -->
        <StackPanel
            x:Name="ProgressPanel"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Spacing="4"
            Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" />
            <ProgressBar x:Name="ProgressBar" Maximum="1" />
        </StackPanel>
    </Grid>
</ContentDialog>
