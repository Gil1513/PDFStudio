<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PDFStudio.Controls.FileBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PDFStudio.Controls">

    <Border
        x:Name="Card"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        PreviewKeyDown="Card_PreviewKeyDown">
        <Grid Padding="20,16,20,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Título  -->
            <Grid>
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Fechar"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Cancel_Click">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!--  Barra: voltar, avançar, subir, caminho, procurar, nova pasta  -->
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    AutomationProperties.Name="Voltar"
                    Click="Back_Click"
                    ToolTipService.ToolTip="Voltar (Alt+←)">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button
                    x:Name="ForwardButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Avançar"
                    Click="Forward_Click"
                    ToolTipService.ToolTip="Avançar (Alt+→)">
                    <FontIcon FontSize="14" Glyph="&#xE72A;" />
                </Button>
                <Button
                    x:Name="UpButton"
                    Grid.Column="2"
                    AutomationProperties.Name="Pasta de cima"
                    Click="Up_Click"
                    ToolTipService.ToolTip="Pasta de cima (Alt+↑)">
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <TextBox
                    x:Name="PathBox"
                    Grid.Column="3"
                    AutomationProperties.Name="Caminho da pasta"
                    KeyDown="PathBox_KeyDown"
                    ToolTipService.ToolTip="Escreva um caminho e tecle Enter" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="4"
                    AutomationProperties.Name="Procurar nesta pasta"
                    PlaceholderText="Procurar nesta pasta"
                    TextChanged="SearchBox_TextChanged" />
                <Button
                    x:Name="NewFolderButton"
                    Grid.Column="5"
                    AutomationProperties.Name="Nova pasta"
                    ToolTipService.ToolTip="Nova pasta">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8F4;" />
                        <TextBlock Text="Nova pasta" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="NewFolderFlyout" Opened="NewFolderFlyout_Opened">
                            <StackPanel Width="260" Spacing="8">
                                <TextBox
                                    x:Name="NewFolderBox"
                                    Header="Nome da pasta nova"
                                    KeyDown="NewFolderBox_KeyDown"
                                    Text="Nova pasta" />
                                <TextBlock
                                    x:Name="NewFolderError"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="CreateFolder_Click"
                                    Content="Criar"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!--  Lugares e lista  -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListView
                    x:Name="PlacesList"
                    AutomationProperties.Name="Lugares"
                    IsItemClickEnabled="True"
                    ItemClick="PlacesList_ItemClick"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PlaceRow">
                            <StackPanel
                                Padding="0,6"
                                AutomationProperties.Name="{x:Bind Name}"
                                Orientation="Horizontal"
                                Spacing="10">
                                <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Padding="16,8,16,8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Opacity="0.7" Text="Nome" />
                        <TextBlock
                            Grid.Column="1"
                            Opacity="0.7"
                            Text="Modificado em" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Opacity="0.7"
                            Text="Tamanho" />
                    </Grid>
                    <ListView
                        x:Name="FilesList"
                        Grid.Row="1"
                        AutomationProperties.Name="Arquivos e pastas"
                        DoubleTapped="FilesList_DoubleTapped"
                        IsDoubleTapEnabled="True"
                        KeyDown="FilesList_KeyDown"
                        SelectionChanged="FilesList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FileRow">
                                <Grid AutomationProperties.Name="{x:Bind Name}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="{x:Bind IconBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Opacity="0.75"
                                        Text="{x:Bind ModifiedText}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Opacity="0.75"
                                        Text="{x:Bind SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="EmptyText"
                        Grid.Row="1"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ProgressRing
                        x:Name="LoadingRing"
                        Grid.Row="1"
                        Width="32"
                        Height="32"
                        IsActive="False" />
                </Grid>
            </Grid>

            <!--  Nome, tipo e botões  -->
            <Grid
                Grid.Row="3"
                ColumnSpacing="10"
                RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="NameLabel"
                    VerticalAlignment="Center"
                    Text="Nome do arquivo:" />
                <TextBox
                    x:Name="NameBox"
                    Grid.Column="1"
                    AutomationProperties.Name="Nome do arquivo"
                    KeyDown="NameBox_KeyDown"
                    TextChanged="NameBox_TextChanged" />
                <ComboBox
                    x:Name="TypeBox"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Tipo de arquivo"
                    SelectionChanged="TypeBox_SelectionChanged" />

                <InfoBar
                    x:Name="MessageBar"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button
                            x:Name="OverwriteButton"
                            Click="Overwrite_Click"
                            Content="Substituir" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ConfirmButton"
                        MinWidth="140"
                        Click="Primary_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="CancelButton"
                        MinWidth="110"
                        Click="Cancel_Click"
                        Content="Cancelar" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
